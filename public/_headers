# Cloudflare Pages response headers.
# Always revalidate the entry points so app updates reach the phone promptly.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Vite puts a content hash in every asset filename, so these never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
